{
  "name": "discord-salesbot",
  "version": "1.0.0",
  "description": "On-chain NFT sales/mint/burn notifier for Discord (TypeScript)",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:debug": "cross-env LOG_LEVEL=DEBUG tsx src/index.ts",
    "start:quiet": "cross-env LOG_LEVEL=ERROR tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "viem": "^2.33.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "cross-env": "^7.0.3",
    "prettier": "^3.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.6.0"
  }
}
